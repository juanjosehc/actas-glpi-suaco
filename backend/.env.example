# =====================================================
# PLANTILLA DE CONFIGURACION LOCAL (SEC-002)
# =====================================================
# Copia este archivo a `backend/.env`, completa los valores reales y NO lo
# commitees: `.env` esta en .gitignore. `application.yml` lo carga via
# `spring.config.import: optional:file:./.env[.properties]`.
#
# En produccion/CI prefiera variables de entorno reales del proceso/container;
# este archivo es para desarrollo local (`cd backend && mvn spring-boot:run`).
# Las variables de entorno reales SIEMPRE tienen prioridad sobre este archivo.

# --- PostgreSQL (OBLIGATORIO: sin esto la app no arranca) ---
# Usuario de la base SaucoDB
DB_USERNAME=postgres
# Password de PostgreSQL que se uso para crear SaucoDB
DB_PASSWORD=

# --- JWT (OBLIGATORIO: sin esto la app no arranca) ---
# Clave de firma HS256 en Base64. Minimimo 256 bits (32 bytes) = 44+ chars Base64.
# Generar una nueva con, por ejemplo:
#   openssl rand -base64 48
JWT_SECRET=

# Vigencia del token en milisegundos (default 24h = 86400000)
# JWT_EXPIRATION=86400000

# --- GLPI (OPCIONAL: si se usa la consulta de equipos por serial) ---
# Tokens de la API REST de GLPI. Vacios = la app arranca sin consultar GLPI.
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=

# --- SMTP (OPCIONAL: si no se configura, el envio de correos se omite) ---
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=
# SEC-108: por defecto JavaMail valida la cadena TLS completa (sin override).
# Solo fijar MAIL_SMTP_TRUST si el relay rota certificados y la validacion
# estricta falla; apuntar al host EXACTO ya verificado:
# MAIL_SMTP_TRUST=

# SEC-111: allow-list de dominios para el correo de envio a firma (CSV).
# Vacio = solo validacion @Email. En produccion usar el dominio corporativo:
# CORREO_DOMINIOS_PERMITIDOS=coltefinanciera.com

# SEC-109: esquema de BD. Desarrollo: update (default). Produccion:
# JPA_DDL_AUTO=validate (Hibernate solo valida, no altera la BD).

# SEC-114: origenes CORS permitidos (CSV). En produccion:
# CORS_ALLOWED_ORIGINS=https://actas.coltefinanciera.com

# --- Otros (todos con defaults seguros en application.yml) ---
# SEC-128: sin valor por defecto; defina GLPI_URL explicitamente. Si el servidor
# interno GLPI no tiene TLS (HTTP por LAN), es decision conciente del entorno
# (SEC-112). Vacio = la app arranca y las llamadas GLPI dan "GLPI no configurado".
# GLPI_URL=https://10.86.1.33/glpi/apirest.php
# STORAGE_ROOT=
# FIRMA_URL_BASE=
# ADMIN_PROTEGIDO_USERNAME=admin